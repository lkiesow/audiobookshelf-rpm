#!/bin/sh

set -e

SPEC=audiobookshelf.spec
USER="Lars Kiesow <lkiesow@uos.de>"
DATE="$(date "+%a %b %d %Y")"

spec_field() {
	sed -n "s/^$1: *\([^ ]*\).*$/\1/p" "$SPEC"
}

# Add a changelog entry for the current Version-Release with the given text.
add_changelog() {
	sed -i "s/^%changelog/%changelog\n\* ${DATE} ${USER} - $(spec_field Version)-$(spec_field Release | sed 's/%.*//')\n- $1\n/" "$SPEC"
}

# Append a line to the most recent changelog entry.
append_changelog() {
	sed -i "0,/^- .*$/s//&\n- $1/" "$SPEC"
}

set_release() {
	sed -i "s/^\(Release: *\)[0-9]*\(.*\)$/\1$1\2/" "$SPEC"
}

UPDATED=


echo "Checking Audiobookshelf"

# Use the workflow's token when available to avoid the low unauthenticated
# API rate limit shared by GitHub Actions runners.
LATEST="$(
	curl -s ${GITHUB_TOKEN:+-H "Authorization: Bearer ${GITHUB_TOKEN}"} \
		'https://api.github.com/repos/advplyr/audiobookshelf/releases/latest' \
		| jq -r '.tag_name // empty' \
		| sed 's/^v//'
	)"
PKG="$(spec_field Version)"

echo "Latest version:  $LATEST"
echo "Package version: $PKG"

if [ -n "$LATEST" ] && [ "$LATEST" != "$PKG" ]; then
	echo "Updating to ${LATEST}"
	sed -i "s/^\(Version: *\)[^ ]*$/\1${LATEST}/" "$SPEC"
	set_release 1
	add_changelog "Update to ${LATEST}"
	git commit "$SPEC" -m "Updating Audiobookshelf to ${LATEST}"
	UPDATED=1
fi


echo "Checking Node.js"

NODE="$(sed -n 's/^%define node *\([^ ]*\).*$/\1/p' "$SPEC")"
NODE_MAJOR="${NODE%%.*}"
NODE_LATEST="$(
	curl -s 'https://nodejs.org/dist/index.json' \
		| jq -r "[.[] | select(.version | startswith(\"v${NODE_MAJOR}.\"))][0].version" \
		| sed 's/^v//'
	)"

echo "Latest Node.js ${NODE_MAJOR}.x: $NODE_LATEST"
echo "Bundled Node.js:    $NODE"

if [ -n "$NODE_LATEST" ] && [ "$NODE_LATEST" != null ] && [ "$NODE_LATEST" != "$NODE" ]; then
	echo "Updating Node.js to ${NODE_LATEST}"
	sed -i "s/^\(%define node *\)[^ ]*$/\1${NODE_LATEST}/" "$SPEC"
	if [ -n "$UPDATED" ]; then
		append_changelog "Update Node.js to ${NODE_LATEST}"
	else
		set_release "$(( $(spec_field Release | sed 's/%.*//') + 1 ))"
		add_changelog "Update Node.js to ${NODE_LATEST}"
	fi
	git commit "$SPEC" -m "Updating Node.js to ${NODE_LATEST}"
fi
